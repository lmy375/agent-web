# Every setting is an AGENT_WEB_-prefixed environment variable; this file is
# read from the working directory the server starts in.

# Default working directory for new threads; the picker can choose any other.
AGENT_WEB_ROOT_DIR=~/agent-web-workspace
# Thread registry and auth secret.
AGENT_WEB_DATA_DIR=~/.agent-web

# Which agents to expose, in order. Unset means all of them.
# AGENT_WEB_AGENTS=claude_code,codex,opencode

# Explicit harness binaries; unset means look them up on PATH.
# AGENT_WEB_CLAUDE_PATH=/usr/local/bin/claude
# AGENT_WEB_CODEX_PATH=/usr/local/bin/codex
# AGENT_WEB_OPENCODE_PATH=/usr/local/bin/opencode

# Long-lived token from `claude setup-token`, when there is no `claude login`.
# AGENT_WEB_CLAUDE_OAUTH_TOKEN=

# Seconds before an idle harness process is stopped; the next prompt resumes it.
AGENT_WEB_IDLE_TIMEOUT_S=900

AGENT_WEB_HOST=127.0.0.1
AGENT_WEB_PORT=8000

# Password for the web UI. Unset disables the login screen, which is only
# allowed on a loopback host.
# AGENT_WEB_PASSWORD=
# AGENT_WEB_AUTH_TTL_S=2592000
# AGENT_WEB_COOKIE_SECURE=true
# AGENT_WEB_ALLOWED_ORIGINS=https://agents.example.com
# AGENT_WEB_ALLOW_NO_AUTH=false

# Built frontend to serve; defaults to ../frontend/dist when it exists.
# AGENT_WEB_STATIC_DIR=../frontend/dist
